# Discord bot token (Developer Portal > Bot > Reset Token).
# This must belong to the bot application you are testing/inviting.
DISCORD_TOKEN=

# Command prefix (optional, defaults to "+")
PREFIX=+

# Optional owner/fallback BloxGen API key. Users can add their own encrypted key
# with +key; auto-generation requires the initiating user's personal key.
BLOXGEN_API_KEY=

# Required when users store personal API keys. Use a long random value.
SESSION_SECRET=

# Dashboard session cookie for the +history command (the official API has no history endpoint).
# Get it on https://bloxgen.net (logged in): F12 > Application > Cookies > https://bloxgen.net
# > copy the value of the "accessToken" cookie. Lasts ~7 days, so refresh it weekly.
BLOXGEN_SESSION_COOKIE=

# (Optional) Fallback log channel ID. You can also set this per server with the
# +logs command (which takes priority over this value). Leave empty to disable.
LOG_CHANNEL_ID=

# Optional: delete messages containing credentials after this many milliseconds.
# 0 keeps messages until manually deleted. Example: 600000 = 10 minutes.
CREDENTIAL_DELETE_AFTER_MS=0
